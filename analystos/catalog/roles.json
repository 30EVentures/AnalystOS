{
 "format": "analystos-role-catalog/1",
 "description": "Every role AnalystOS offers, for hire by people and agents. Price: to be determined; no price has been set for any role (rate_cents_per_engagement_hour = 'tbd'). A role is 'available' only with a recorded passing evaluation; eval.method says how it was run: 'mock' = a worked example written for this role and checked in a working session, with no model call; 'mock-family' = the same, but the worked example was written for another role in this role's family, not for this one; 'live' = the production model. Each role delivers the verified analysis in the format its family reads (delivers_today: verified-deck, verified-memo or verified-workbook), and, for roles whose deliverables include a draft, register, case-file, reconciliation, plan or code, that work product inside it (Slice 126). See specs/slice-108, slice-117.",
 "statuses": [
  "planned",
  "built",
  "evaluated",
  "available"
 ],
 "boundaries": {
  "deliverable-only": "Produces work product; acts on nothing.",
  "approval-gated": "May act in the client's own tools, only after a named human approves each action (gated_actions).",
  "human-decides": "Prepares the full case; a qualified, named human makes the decisions listed in human_decides."
 },
 "waves": {
  "1": "Buildable on the existing verified-evidence engine (the role may still leave decisions to a human)",
  "2": "Needs a new skill; output is still work product",
  "3": "Acts in the client's own tools, so needs connectors and per-action approval gates (exactly the approval-gated roles)",
  "4": "The role's core output is a regulated decision, filing or disposition; needs a review of the rules that apply and a decision-recording workflow before it is built (always human-decides)"
 },
